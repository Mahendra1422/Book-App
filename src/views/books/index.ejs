<h1>📚 Books</h1>

<div style="margin-bottom: 20px;">
    <a href="/books/create" class="btn">Add New Book</a>
</div>

<form method="GET" action="/books" style="background: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;">
        <input type="text" name="search" placeholder="Search (name/description)" value="<%= typeof search !== 'undefined' ? search : '' %>">
        <input type="text" name="author" placeholder="Filter by author" value="<%= typeof author !== 'undefined' ? author : '' %>">
        <input type="date" name="from" placeholder="From date" value="<%= typeof from !== 'undefined' ? from : '' %>">
        <input type="date" name="to" placeholder="To date" value="<%= typeof to !== 'undefined' ? to : '' %>">
        <select name="sortBy">
            <option value="createdAt" <%= typeof sortBy !== 'undefined' && sortBy === 'createdAt' ? 'selected' : '' %>>Sort by Date</option>
            <option value="name" <%= typeof sortBy !== 'undefined' && sortBy === 'name' ? 'selected' : '' %>>Sort by Name</option>
            <option value="author" <%= typeof sortBy !== 'undefined' && sortBy === 'author' ? 'selected' : '' %>>Sort by Author</option>
            <option value="publishDate" <%= typeof sortBy !== 'undefined' && sortBy === 'publishDate' ? 'selected' : '' %>>Sort by Publish Date</option>
        </select>
        <select name="order">
            <option value="asc" <%= typeof order !== 'undefined' && order === 'asc' ? 'selected' : '' %>>Ascending</option>
            <option value="desc" <%= typeof order !== 'undefined' && order === 'desc' ? 'selected' : '' %>>Descending</option>
        </select>
    </div>
    <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn">Search/Filter</button>
        <a href="/books" class="btn" style="background: #6c757d;">Clear</a>
    </div>
</form>

<% if (books && books.length > 0) { %>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Author</th>
                <th>Description</th>
                <th>Publish Date</th>
            </tr>
        </thead>
        <tbody>
            <% books.forEach(book => { %>
                <tr>
                    <td><strong><%= book.name %></strong></td>
                    <td><%= book.author %></td>
                    <td><%= book.description %></td>
                    <td>
                        <% if (book.publishDate) { %>
                            <%= new Date(book.publishDate).toISOString().split('T')[0] %>
                        <% } else { %>
                            -
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
        <p>Showing <%= (page - 1) * limit + 1 %> - <%= Math.min(page * limit, total) %> of <%= total %> books</p>
        <div>
            <% 
            // Build query string preserving filters
            const queryParams = [];
            if (typeof search !== 'undefined' && search) queryParams.push(`search=${encodeURIComponent(search)}`);
            if (typeof author !== 'undefined' && author) queryParams.push(`author=${encodeURIComponent(author)}`);
            if (typeof from !== 'undefined' && from) queryParams.push(`from=${encodeURIComponent(from)}`);
            if (typeof to !== 'undefined' && to) queryParams.push(`to=${encodeURIComponent(to)}`);
            if (typeof sortBy !== 'undefined' && sortBy) queryParams.push(`sortBy=${encodeURIComponent(sortBy)}`);
            if (typeof order !== 'undefined' && order) queryParams.push(`order=${encodeURIComponent(order)}`);
            const queryString = queryParams.length > 0 ? '&' + queryParams.join('&') : '';
            %>
            <% if (page > 1) { %>
                <a href="?page=<%= page - 1 %><%= queryString %>" class="btn" style="background: #6c757d;">Previous</a>
            <% } %>
            <% if (page * limit < total) { %>
                <a href="?page=<%= page + 1 %><%= queryString %>" class="btn" style="background: #6c757d;">Next</a>
            <% } %>
        </div>
    </div>
<% } else { %>
    <p>No books found. <a href="/books/create">Add your first book</a></p>
<% } %>
